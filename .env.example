# Copy to .env and edit. Never commit .env. All secrets below are placeholders.

# --- Database (docker-compose) -------------------------------------------------------------
POSTGRES_DB=feya
POSTGRES_USER=feya
POSTGRES_PASSWORD=change-me

# --- Backend ---------------------------------------------------------------------------------
# "dev" (together with SPRING_PROFILES_ACTIVE=dev) enables the seed catalog, dev OTP and sandbox payments.
# In production leave SPRING_PROFILES_ACTIVE unset and set FEYA_ENV=production (the default).
FEYA_ENV=dev
SPRING_PROFILES_ACTIVE=dev
# At least 32 random characters. Generate with: openssl rand -base64 48
FEYA_JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# Dev only: return the one-time code in the API response instead of (not) sending an SMS.
FEYA_DEV_OTP_ENABLED=true
# none | sandbox | <real provider id>. "sandbox" is rejected at startup when FEYA_ENV=production.
FEYA_PAYMENTS_PROVIDER=sandbox
# HMAC secret shared with the payment provider for webhook signature verification.
FEYA_PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated exact origins, e.g. https://app.feya.kz,https://admin.feya.kz
FEYA_CORS_ALLOWED_ORIGINS=
FEYA_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*
# Optional CDN/base URL prepended to /media/... image paths.
FEYA_MEDIA_BASE_URL=
FEYA_RATE_LIMIT_ENABLED=true
FEYA_SWAGGER_ENABLED=false
# logging | fcm (see docs/INTEGRATIONS.md)
FEYA_PUSH_PROVIDER=logging
# logging (delivers nothing) | twilio
FEYA_SMS_PROVIDER=logging
# FEYA_SMS_TWILIO_ACCOUNT_SID=
# FEYA_SMS_TWILIO_AUTH_TOKEN=
# FEYA_SMS_TWILIO_FROM=            # an E.164 number, or use the messaging service below
# FEYA_SMS_TWILIO_MESSAGING_SERVICE_SID=
# With FEYA_PAYMENTS_PROVIDER=freedompay (the webhook secret above is then not used: the secret key signs and verifies):
# FEYA_FREEDOMPAY_API_URL=
# FEYA_FREEDOMPAY_MERCHANT_ID=
# FEYA_FREEDOMPAY_SECRET_KEY=
# FEYA_FREEDOMPAY_RESULT_NOTIFY_SCRIPT_NAME=result.php
# FEYA_FREEDOMPAY_SUCCESS_URL=
# FEYA_FREEDOMPAY_FAILURE_URL=

# --- Mobile (passed with --dart-define, not read from this file) ----------------------------------
# API_BASE_URL=https://api.feya.kz
# MAP_LINK_TEMPLATE=https://2gis.kz/almaty/geo/{lng},{lat}
# SUPPORT_PHONE=+77000000000
# SUPPORT_WHATSAPP=+77000000000
# PRIVACY_URL=https://feya.kz/privacy
# TERMS_URL=https://feya.kz/terms

# --- Render / PaaS: alternative to FEYA_DB_URL (host/port/name + FEYA_DB_USER/FEYA_DB_PASSWORD) ---
# FEYA_DB_HOST=
# FEYA_DB_PORT=5432
# FEYA_DB_NAME=feya
